#!/usr/bin/env python3
"""使用 skill 内置的调度运行时启动命令行工具。"""

from __future__ import annotations

import sys
from pathlib import Path


SKILL_ROOT = Path(__file__).resolve().parents[1]

for required in (
    SKILL_ROOT / "adaptive_core" / "__init__.py",
    SKILL_ROOT / "opensmi" / "__init__.py",
):
    if not required.is_file():
        raise SystemExit(f"bundled skill runtime is missing: {required}")

sys.path.insert(0, str(SKILL_ROOT))

from opensmi.cli import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
